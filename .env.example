# App Builder / Adobe I/O Runtime credentials are managed by `aio app use` and `npm run setup`
# (written to .env / .aio). Do not commit real secrets — this file documents required keys only.

# ---- Added by commerce-app-builder-generator ----
# External integrations (see requirements/app-builder/Dish_PriceChange.md §5.4)

# Adobe Commerce (catalog/pricing) — PaaS, Oauth1aConnection (§5.4, blocked by §11 item 2)
# Base URL is also injected into web actions via inputs.COMMERCE_BASE_URL.
COMMERCE_BASE_URL=
COMMERCE_CONSUMER_KEY=
COMMERCE_CONSUMER_SECRET=
COMMERCE_ACCESS_TOKEN=
COMMERCE_ACCESS_TOKEN_SECRET=

# NOTE: Recurly (§5.4), Partner Billing Platform (§5.4), and UMS Reporting (§5.4) read their
# endpoints/credentials from businessConfig (change_sub_recurly_request.*, partner_billing.*,
# ums_reporting.*), not from environment variables. PBP/UMS token acquisition is Reinterpretation
# §11 item 3 — if the resolved design sources tokens from env instead of businessConfig, add the
# corresponding keys here.

# Adobe IMS OAuth Server-to-Server credentials — used to mint the access token that
# authenticates ABDB requests (actions/configuration load/save) and I/O Events publishes
# (lib/utils/events-publisher).
IMS_OAUTH_S2S_CLIENT_ID=
IMS_OAUTH_S2S_CLIENT_SECRET=
IMS_OAUTH_S2S_ORG_ID=
IMS_OAUTH_S2S_SCOPES=

# Reinterpretation §11 item 1 (BLOCKING — Internal I/O Events Provider): id of the custom
# "Price Change Internal Events" provider (app.commerce.config.ts `eventing.external`), created
# automatically by aio-commerce-lib-app's externalEventsStep during installation. Left empty here
# pending confirmation of the provider/registration model — populate once known.
PRICE_CHANGE_INTERNAL_EVENTS_PROVIDER_ID=
